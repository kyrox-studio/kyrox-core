APP_NAME=kyrox-core
APP_VERSION=0.1.0
# production|prod enables the startup guard: Core refuses to start when
# JWT_SECRET_KEY or CORE_IDENTITY_ACTION_TOKEN_SECRET_KEY is empty, shorter than
# 32 characters, a public default (dev-insecure/change-me) or both are equal,
# or when DEBUG=true. Use ENVIRONMENT=production on the live server.
ENVIRONMENT=development
DEBUG=false
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kyrox_core
JWT_SECRET_KEY=dev-insecure-change-me-use-env-in-production-32b
JWT_ALGORITHM=HS256
# Separate secret for hash-only identity action tokens (activation, password
# reset). Required in production (>= 32 random characters, != JWT_SECRET_KEY).
CORE_IDENTITY_ACTION_TOKEN_SECRET_KEY=dev-insecure-identity-action-token-secret-change-me
# Access JWT lifetime (days). Must match Fair CRM ACCESS_TOKEN_EXPIRE_DAYS.
# ADR-0003 target is 15 minutes; it stays 15 days until the embedded FAIR Stand
# editor refreshes on 401. ACCESS_TOKEN_EXPIRE_MINUTES overrides the day value.
ACCESS_TOKEN_EXPIRE_DAYS=15
# ACCESS_TOKEN_EXPIRE_MINUTES=15
# Refresh token lifetime and absolute session lifetime (days, ADR-0003: 30).
# Must be >= the access lifetime. Sessions end this long after sign-in.
REFRESH_TOKEN_EXPIRE_DAYS=30

# Read-only product lifecycle contract credential. Configure the matching value in
# FAIR CRM as KYROX_CORE_PRODUCT_LIFECYCLE_TOKEN. Never reuse JWT/provider secrets.
# Required: >= 32 random characters. Unset, short or dev-insecure values make
# lifecycle-snapshot and retained-audit purge fail closed (503).
CORE_PRODUCT_LIFECYCLE_TOKEN=

# Core-owned platform/identity email. Do not reuse FAIR CRM tenant mail credentials here.
# Use `log` for local development/tests and `smtp` for real delivery.
CORE_EMAIL_PROVIDER=log
CORE_EMAIL_FROM=
CORE_SMTP_HOST=
CORE_SMTP_PORT=587
CORE_SMTP_USERNAME=
CORE_SMTP_PASSWORD=
CORE_SMTP_STARTTLS=true
CORE_SMTP_SSL=false
CORE_SMTP_TIMEOUT_SECONDS=10
